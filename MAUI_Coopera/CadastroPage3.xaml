<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Coopera.CadastroPage3"
             BackgroundColor="#23539A"
             Title="">
    
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
    </ContentPage.Resources>

    <StackLayout HorizontalOptions="Center" Padding="0,0,0,20">

        <Image
            Source="logo_inicial.png"
            HeightRequest="60"
            Aspect="AspectFit"
            SemanticProperties.Description="Logo do Coopera de uma formiga dentro de um circulo"
            Margin="0,30,0,40"/>

        <Label
            Text="Adicionar foto de perfil!"
            FontSize="27"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,90"/>

        <Border StrokeShape="100"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                HeightRequest="200"
                WidthRequest="200"
                StrokeThickness="0.5"
                Margin="0,0,0,0">
            <Image
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Aspect="AspectFill"
                Source="mais.png"
                x:Name="imgPerfil">

                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                </Image.GestureRecognizers>
                
            </Image>
        </Border>


        <Border StrokeShape="11" WidthRequest="325" Margin="0,50,0,0">
            <Button
                x:Name="btnFinalizar"
                Clicked="btnFinalizar_Clicked"
                Text="Finalizar"
                FontSize="Body"
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Fill"
                WidthRequest="325"
                HeightRequest="60"/>
        </Border>

        <Label
            Text="Agora não..."
            TextDecorations="Underline"
            FontSize="15"
            Margin="0,10,0,0"
            HorizontalTextAlignment="Center"
            x:Name="lblAgoraNao">

            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </Label.GestureRecognizers>
            
        </Label>

    </StackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Coopera.InicioPage"
             Title=""
             BackgroundColor="#23539A">
    
    <ScrollView>
        <StackLayout Spacing="5" Margin="5" Padding="10">
            <VerticalStackLayout>
                <Border BackgroundColor="White" StrokeShape="20">
                    <Entry
                        Placeholder="Pesquisar por nome"
                        TextColor="Black"
                        WidthRequest="330"
                        x:Name="txt"
                        TextChanged="Filtro_Changed"/>
                </Border>
                <HorizontalStackLayout Margin="0,10,0,0">
                    <Border BackgroundColor="White" StrokeShape="20">
                        <Picker
                            Title="Filtrar por Serviço"
                            WidthRequest="250"
                            TextColor="Black"
                            x:Name="pckServico"
                            HandlerChanged="Filtro_Changed"/>
                    </Border>
                    <Border BackgroundColor="White" StrokeShape="20">
                        <Picker
                            Title="Qntd. ⭐"
                            WidthRequest="125"
                            x:Name="pckEstrela"
                            TextColor="Black"
                            HorizontalTextAlignment="Center"
                            HandlerChanged="Filtro_Changed"/>
                    </Border>
                </HorizontalStackLayout>

                <Border StrokeShape="15" HeightRequest="600" BackgroundColor="#83A7E8" Margin="0,30,0,0" StrokeThickness="0" Padding="7" HorizontalOptions="Center" WidthRequest="370">
                    <CollectionView x:Name="list">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="15" Padding="10" WidthRequest="360" BackgroundColor="White">
                                    <VerticalStackLayout>
                                        <HorizontalStackLayout>
                                            <VerticalStackLayout>
                                                <Border StrokeThickness="0" StrokeShape="10">
                                                    <Image
                                                        Source="{Binding Foto}"
                                                        BackgroundColor="DarkGrey"
                                                        HeightRequest="100"
                                                        WidthRequest="100"
                                                        Aspect="AspectFill"
                                                        />
                                                </Border>
                                                <HorizontalStackLayout>
                                                    <Image
                                                        Source="estrela.png"
                                                        WidthRequest="20"
                                                        HeightRequest="20"
                                                        Margin="0,20,0,0"
                                                        Aspect="AspectFill"/>
                                                    <Label
                                                        Text="{Binding Estrelas}"
                                                        Margin="5,20,0,0"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout>
                                                <Label
                                                    Text="{Binding NomeCompleto}"
                                                    Margin="10,0,0,0"
                                                    FontAttributes="Bold"
                                                    FontSize="17"/>
                                                <Label
                                                    Text="{Binding Email}"
                                                    Margin="10,5,0,0"/>
                                                <HorizontalStackLayout>
                                                    <Button
                                                        Margin="10,65,0,0"
                                                        WidthRequest="170"
                                                        BackgroundColor="#23539A"
                                                        Text="Ver Perfil"
                                                        Clicked="Button_Clicked"/>
                                                    <ImageButton
                                                        Margin="10,65,0,0"
                                                        Source="whats.png"
                                                        WidthRequest="30"
                                                        HeightRequest="30"
                                                        Aspect="AspectFit"
                                                        Clicked="ImageButton_Clicked"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
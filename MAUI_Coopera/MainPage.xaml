<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Coopera.MainPage"
             BackgroundColor="#23539A"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
    </ContentPage.Resources>

    <StackLayout HorizontalOptions="Center" Padding="0,0,0,20">

        <Image
            Source="logo_inicial.png"
            HeightRequest="60"
            Aspect="AspectFit"
            SemanticProperties.Description="Logo do Coopera de uma formiga dentro de um circulo"
            Margin="0,30,0,40"/>

        <Label
            Text="Para quem busca oportunidades"
            FontSize="27"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,90"/>
        <VerticalStackLayout Padding="30,0" Spacing="15" HorizontalOptions="Center">
            <Label Text="Email" HorizontalTextAlignment="Start" FontSize="18" />
            <Border StrokeShape="10" BackgroundColor="#1aF4F4F4">
                <Entry x:Name="txtEmail" WidthRequest="300" BackgroundColor="Transparent" FontSize="15" Margin="10"/>
            </Border>
            <Label Text="Senha" HorizontalTextAlignment="Start" FontSize="18" Margin="0,10,0,0"/>
            <Border StrokeShape="10" BackgroundColor="#1aF4F4F4">
                <Entry x:Name="txtPass" WidthRequest="300" BackgroundColor="Transparent" FontSize="15" Margin="10" IsPassword="True"/>
            </Border>
        </VerticalStackLayout>

        <HorizontalStackLayout Margin="0,80,0,0" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Não tem uma conta?" FontSize="14" Margin="0,0,2,0"/>
            <Label Text="Cadastre-se" FontSize="14" x:Name="btnCadastrar" TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>

        <BoxView VerticalOptions="FillAndExpand" BackgroundColor="Transparent" />

        <Border StrokeShape="11" StrokeThickness="0" WidthRequest="325">
            <Button
                x:Name="btnEntrar"
                Text="Entrar"
                FontSize="Body"
                SemanticProperties.Hint="Botão de entrar"
                Clicked="btnEntrar_Clicked"
                HorizontalOptions="Fill"
                WidthRequest="325"
                HeightRequest="60"/>
        </Border>

        <Border StrokeShape="11" StrokeThickness="0" WidthRequest="325" Margin="0,5,0,0">
            <Button
                Text="Escqueci minha senha"
                FontSize="Body"
                SemanticProperties.Hint="Botão de esqueci minha senha"
                HorizontalOptions="Fill"
                WidthRequest="325"
                HeightRequest="60"
                BackgroundColor="#1883FF"
                x:Name="btnEsqueciSenha"
                Clicked="btnEsqueciSenha_Clicked"/>
        </Border>

    </StackLayout>



</ContentPage>

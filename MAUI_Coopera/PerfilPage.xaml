<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Coopera.PerfilPage"
             Title=""
             BackgroundColor="#23539A">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout HorizontalOptions="Center">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout>
                    <Border StrokeShape="30" Margin="250,30,0,0">
                        <Button
                        Text="Sair"
                        FontAttributes="Bold"
                        FontSize="20"
                        x:Name="btnSair"
                        Clicked="btnSair_Clicked"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="5" Margin="0,110,0,0">
                    <Border WidthRequest="170"
                        HeightRequest="170"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="0.5"
                        BackgroundColor="White">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100"/>
                        </Border.StrokeShape>

                        <Image
                        Source="dotnet_bot.png"
                        Aspect="AspectFill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        BackgroundColor="White"
                        x:Name="imgPerfil">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Border>
                    <Label
                    Text="Olá, "
                    FontSize="25"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"
                    x:Name="lblOla"
                    HorizontalTextAlignment="Center"
                    />

                    <Border StrokeShape="11" StrokeThickness="0" WidthRequest="325" Margin="0,5,0,0">
                        <Button
                        Text="Virar Profissional"
                        FontSize="Body"
                        HorizontalOptions="Fill"
                        WidthRequest="325"
                        HeightRequest="60"
                        BackgroundColor="#FFFFFF"
                        x:Name="btnProfissional"
                        Clicked="btnProfissional_Clicked"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>